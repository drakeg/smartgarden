# Example production environment variables for Smart Garden
# Copy to `.env.prod` and fill with secure values before deploying.

# External port published by nginx in docker-compose.prod.yml
APP_PORT=80

# Django
# Required when DEBUG=False. Keep this stable across restarts/deployments.
SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=your.domain.com

# HTTPS / reverse proxy
# Set True only when Nginx is reachable through a trusted TLS-terminating proxy
# or load balancer that sets X-Forwarded-Proto. Keep False for direct exposure.
TRUST_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True

# Database (Postgres)
POSTGRES_DB=smartgarden
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional override: a full DATABASE_URL takes precedence over POSTGRES_*.
# URL-encode special characters in credentials when using this form.
# DATABASE_URL=postgres://postgres:encoded-password@db:5432/smartgarden

# Email (generic SMTP)
# Required for registration confirmation emails in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@your.domain.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Optional async email delivery
# Leave blank to send email synchronously from the web process.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
# Start with: docker compose --env-file .env.prod -f docker-compose.prod.yml --profile async-email up -d --build

# Developer API entitlement gate
# When True, /api/ viewsets require an active DeveloperAccess entitlement.
# Payment-provider webhooks can update the entitlement record after checkout,
# renewal, cancellation, or failed payment.
API_PAYWALL_ENABLED=False
# Required when enabling the developer paywall in production.
# Start Redis with the api-paywall Compose profile; use a distinct DB from Celery.
API_THROTTLE_CACHE_URL=redis://redis:6379/1
API_RATE_STARTER=100/hour
API_RATE_PRO=1000/hour
API_RATE_ENTERPRISE=5000/hour
