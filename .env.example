# Smart Garden development environment
# Copy to .env before running docker compose.

# Host port exposed by Docker Compose.
APP_PORT=8000

DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional developer API paywall. Leave False for normal local development.
API_PAYWALL_ENABLED=False

# Optional async email delivery with Docker Compose.
# To enable, set this and start the async-email profile:
# docker compose --profile async-email up --build
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
