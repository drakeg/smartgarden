# Smart Garden development environment
# Copy to .env before running docker compose.

# Host port exposed by Docker Compose.
APP_PORT=8000

DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional developer API paywall. Leave False for normal local development.
API_PAYWALL_ENABLED=False
# For a shared throttle counter when using multiple workers/containers:
# API_THROTTLE_CACHE_URL=redis://redis:6379/1
# Enable Redis with: docker compose --profile api-paywall up --build
# Per-user developer API request rates, active only when the paywall is enabled.
API_RATE_STARTER=100/hour
API_RATE_PRO=1000/hour
API_RATE_ENTERPRISE=5000/hour

# Optional async email delivery with Docker Compose.
# To enable, set this and start the async-email profile:
# docker compose --profile async-email up --build
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Optional daily care-reminder email notifications.
# Requires CELERY_BROKER_URL and the async-email Compose profile.
CARE_REMINDER_EMAILS_ENABLED=False
CARE_REMINDER_EMAIL_HOUR=8
TIME_ZONE=UTC
SITE_BASE_URL=http://localhost:8000
